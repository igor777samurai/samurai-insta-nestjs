{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/aularis-backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/aularis-backend/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/aularis-backend",
  "projects": {
    "aularis-backend": {
      "type": "application",
      "root": "apps/aularis-backend",
      "entryFile": "main",
      "sourceRoot": "apps/aularis-backend/src",
      "compilerOptions": {
        "deleteOutDir": true,
        "builder": "tsc",
        "tsConfigPath": "apps/aularis-backend/tsconfig.app.json"
      }
    }
  }
}