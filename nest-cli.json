{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "tsc",
    "tsConfigPath": "apps/api-backend/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-backend",
  "projects": {
    "api-backend": {
      "type": "application",
      "root": "apps/api-backend",
      "entryFile": "main",
      "sourceRoot": "apps/api-backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-backend/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    }
  }
}